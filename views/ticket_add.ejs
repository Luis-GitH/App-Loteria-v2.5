<section class="ticket-add card p-4">
  <h2>Añadir boleto desde el móvil</h2>
  <p>Adjunta una foto nítida del boleto. Intentaremos leer el QR de la propia foto; si no fuera posible, también puedes enfocarlo con la cámara.</p>

  <form id="ticketAddForm" method="post" action="/boletos/nuevo" enctype="multipart/form-data">
    <div class="mb-3">
      <label class="form-label d-block">Foto del boleto</label>
      <div class="d-flex flex-wrap gap-2">
        <label for="ticketCamera" class="btn mb-0">Tomar foto</label>
        <label for="ticketGallery" class="btn mb-0">Elegir de la galería</label>
      </div>
      <input id="ticketCamera" name="foto" type="file" accept="image/*" capture="environment" class="visually-hidden">
      <input id="ticketGallery" name="foto" type="file" accept="image/*" class="visually-hidden">
      <small id="selectedPhotoName" class="text-muted d-block mt-2">Usa una foto nítida donde se vea completo el boleto.</small>
      <div id="photoPreview" class="mt-3" style="display:none;">
        <img src="" alt="Vista previa" class="img-fluid rounded border">
      </div>
    </div>

    <input type="hidden" name="qrData" id="qrDataField">
    <div class="mb-3">
      <label class="form-label d-block">Lectura de QR</label>
      <p id="qrStatus" class="text-muted mb-2">Pendiente de escanear.</p>
      <div id="qr-reader" class="qr-reader"></div>
      <div id="qr-reader-file" style="display:none;"></div>
      <button id="restartScan" type="button" class="btn mt-2" style="display:none;">Escanear con cámara</button>
    </div>

    <div class="d-flex gap-2">
      <button id="submitTicketBtn" type="submit" class="btn" disabled>Guardar boleto</button>
      <a class="btn" href="/tickets">Cancelar</a>
    </div>
  </form>
</section>

<script src="/public/vendor/html5-qrcode.min.js"></script>
<script>
  (function () {
    const cameraInput = document.getElementById('ticketCamera');
    const galleryInput = document.getElementById('ticketGallery');
    const photoInputs = [cameraInput, galleryInput].filter(Boolean);
    const selectedPhotoName = document.getElementById('selectedPhotoName');
    const photoPreview = document.getElementById('photoPreview');
    const previewImg = photoPreview ? photoPreview.querySelector('img') : null;
    const qrField = document.getElementById('qrDataField');
    const qrStatus = document.getElementById('qrStatus');
    const submitBtn = document.getElementById('submitTicketBtn');
    const restartBtn = document.getElementById('restartScan');
    const readerId = 'qr-reader';
    const fileReaderId = 'qr-reader-file';
    let activePhotoInput = null;
    let previewUrl = null;

    function updateSubmitState() {
      const hasPhoto = activePhotoInput && activePhotoInput.files && activePhotoInput.files.length > 0;
      if (submitBtn) submitBtn.disabled = !hasPhoto;
    }

    if (previewImg) {
      photoInputs.forEach((input) => input.addEventListener('change', function () {
        const file = this.files && this.files[0];
        if (file) {
          activePhotoInput = this;
          photoInputs.forEach((other) => {
            if (other !== this) other.value = '';
          });
          if (previewUrl) URL.revokeObjectURL(previewUrl);
          previewUrl = URL.createObjectURL(file);
          previewImg.src = previewUrl;
          photoPreview.style.display = 'block';
          if (selectedPhotoName) selectedPhotoName.textContent = file.name || 'Foto preparada.';
          qrField.value = '';
          restartBtn.style.display = 'none';
          readQRFromPhoto(file);
        } else {
          activePhotoInput = null;
          photoPreview.style.display = 'none';
          previewImg.removeAttribute('src');
          if (selectedPhotoName) selectedPhotoName.textContent = 'Usa una foto nítida donde se vea completo el boleto.';
        }
        updateSubmitState();
      }));
    }

    if (!window.Html5Qrcode) {
      if (qrStatus) qrStatus.textContent = 'No se pudo cargar el lector de QR.';
      return;
    }

    const html5QrCode = new Html5Qrcode(readerId);
    const fileQrCode = new Html5Qrcode(fileReaderId);
    let scannerRunning = false;

    async function readQRFromPhoto(file) {
      if (!file || !qrStatus) return null;
      qrStatus.textContent = 'Leyendo QR de la foto...';
      try {
        let result = null;
        if (fileQrCode.scanFileV2) {
          const res = await fileQrCode.scanFileV2(file, false);
          result = res?.decodedText || res;
        } else if (fileQrCode.scanFile) {
          result = await fileQrCode.scanFile(file, false);
        }
        if (result) {
          applyQRResult(result, { from: 'photo' });
          return result;
        }
      } catch (err) {
        // fall through to camera
      }
      qrStatus.textContent = 'No se leyó en el navegador. Pulsa Guardar para que el servidor analice la foto o usa la cámara.';
      restartBtn.style.display = 'inline-block';
      return null;
    }

    function applyQRResult(text, opts = {}) {
      if (!text) return;
      qrField.value = text;
      qrStatus.textContent = opts.from === 'photo' ? 'QR leído desde la foto.' : 'QR capturado correctamente.';
      updateSubmitState();
      restartBtn.style.display = 'none';
      html5QrCode.stop().then(() => { scannerRunning = false; }).catch(() => { scannerRunning = false; });
    }

    function startScanner() {
      if (!qrStatus) return;
      Html5Qrcode.getCameras()
        .then((devices) => {
          if (!devices || !devices.length) {
            qrStatus.textContent = 'No se encontró ninguna cámara disponible.';
            return;
          }
          const backCam = devices.find((d) => /back|rear|environment|atrás|trase/i.test(d.label)) || devices[0];
          html5QrCode
            .start(
              { deviceId: { exact: backCam.id } },
              { fps: 8, qrbox: { width: 240, height: 240 }, aspectRatio: 1 },
              onScanSuccess,
              () => {
                if (!scannerRunning) qrStatus.textContent = 'Buscando códigos QR...';
              }
            )
            .then(() => {
              scannerRunning = true;
              qrStatus.textContent = 'Apunta la cámara al QR del boleto.';
            })
            .catch(() => {
              qrStatus.textContent = 'No se pudo iniciar la cámara. Comprueba los permisos.';
            });
        })
        .catch(() => {
          qrStatus.textContent = 'No se pudo acceder a la cámara. Comprueba los permisos.';
        });
    }

    function onScanSuccess(text) {
      if (!text) return;
      applyQRResult(text);
    }

    if (restartBtn) {
      restartBtn.addEventListener('click', () => {
        qrField.value = '';
        qrStatus.textContent = 'Reiniciando escáner...';
        updateSubmitState();
        startScanner();
        restartBtn.style.display = 'none';
      });
    }

    window.addEventListener('beforeunload', () => {
      html5QrCode.stop().catch(() => {});
    });
  })();
</script>
