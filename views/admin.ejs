<% const totalUsers = stats && typeof stats.users === 'number' ? stats.users :
0; const totalLogins = stats && typeof stats.logins === 'number' ? stats.logins
: 0; const totalAttempts = stats && typeof stats.intentos === 'number' ?
stats.intentos : 0; %>

<section class="admin-maintenance">
  <h2>Mantenimiento (admin)</h2>
  <p>
    Desde aqu&iacute; puedes saltar a los listados detallados para administrar
    usuarios, revisar accesos y vigilar intentos fallidos.
  </p>

  <div class="row g-3 mt-3">
    <div class="col-6 col-sm-6 col-md-3 col-lg-2">
      <div class="card h-40 p-4">
        <!-- <h3>Usuarios</h3> -->
        <a class="btn btn-primary" href="/admin/users"
          >mantenimiento Usuarios</a
        >
        <!-- <p class="text-muted mb-2">Altas, bajas y modificaciones de cuentas.</p> -->
        <p>Usuarios: <%= totalUsers %></p>
      </div>
    </div>
    <div class="col-6 col-sm-6 col-md-3 col-lg-2">
      <div class="card h-40 p-4">
        <!-- <h3>Accesos</h3> -->
        <a class="btn btn-primary" href="/admin/accesos">Accesos</a>
        <!-- <p class="text-muted mb-2">Últimos 100 inicios de sesión registrados.</p> -->
        <p>Nº inicios: <%= totalLogins %></p>
      </div>
    </div>
    <div class="col-6 col-sm-6 col-md-3 col-lg-2">
      <div class="card h-60 p-4">
        <!-- <h3>Intentos</h3> -->
        <a class="btn btn-primary" href="/admin/intentos">Intentos de acceso</a>
        <!-- <p class="text-muted mb-2">Intentos fallidos recientes para auditar.</p> -->
        <p>Nº Intentos: <%= totalAttempts %></p>
      </div>
    </div>
    <div class="col-6 col-sm-6 col-md-3 col-lg-2">
      <div class="card h-60 p-4">
        <!-- <h3>Escanear boleto</h3> -->
        <p class="text-muted mb-2">Escanea el QR y muestra los premios.</p>
        <a class="btn btn-primary" href="/admin/escanear"
          >Abrir esc&aacute;ner</a
        >
      </div>
    </div>
    <!-- BORRADO de BOLETOS -->
    <div class="col-6 col-sm-6 col-md-3 col-lg-2">
      <div class="card h-80 p-4">
        <h3>Borrar boleto</h3>
        <form method="POST" action="/admin/boletos/delete/confirm">
          <label class="form-label small mb-1" for="delete-ticket-id"
            >ID del boleto</label
          >
          <input
            id="delete-ticket-id"
            name="identificador"
            class="form-control mb-2"
            required
          />
          <label class="form-label small mb-1" for="delete-ticket-type"
            >Tipo (opcional)</label
          >
          <select id="delete-ticket-type" name="tipo" class="form-select mb-2">
            <option value="">Auto-detectar</option>
            <option value="primitiva">Primitiva</option>
            <option value="euromillones">Euromillones</option>
            <option value="gordo">El Gordo</option>
          </select>
          <div class="form-check mb-2">
            <input
              class="form-check-input"
              type="checkbox"
              id="delete-ticket-image"
              name="deleteImage"
              checked
            />
            <label class="form-check-label small" for="delete-ticket-image"
              >Eliminar imagen asociada</label
            >
          </div>
          <button type="submit" class="btn btn-warning">Verificar</button>
        </form>
      </div>
    </div>

    <!-- REGISTRO DE PREMIOS -->
    <div class="col-6 col-sm-6 col-md-3 col-lg-2">
      <div class="card h-80 p-4">
        <h3>Registrar premios</h3>
        <!-- <p class="text-muted mb-2">Calcula y registra los gastos y premios de la semana.</p> -->
        <form
          method="POST"
          action="/admin/premios-semana"
          onsubmit="
            return confirm(
              'Registrar el total de premios de esa semana en movimientos?',
            );
          "
        >
          <label class="form-label small mb-1" for="week-input"
            >Lunes de la semana</label
          >
          <input
            id="week-input"
            type="date"
            name="week"
            class="form-control"
            value="<%= defaultWeekMonday || '' %>"
            required
          />
          <button type="submit" class="btn btn-success mt-2">
            Calcular y guardar
          </button>
        </form>
      </div>
    </div>
    
    <!-- ENVIO DE LOS BOLETOS-->
    <div class="col-6 col-sm-6 col-md-3 col-lg-2">
      <div class="card h-80 p-4">
        <!-- <h3>Envío de boletos</h3> -->
        <!-- <p class="text-muted mb-2">Enviar por correo de los boletos.</p> -->
        <form
          method="POST"
          action="/admin/send-week-tickets" onsubmit="
            return confirm(
              'Enviar boletos de la semana actual por correo a administradores?',
            );
          "
        >
          <label class="d-block mb-2">
            <input type="checkbox" name="adjuntarExcel" value="1" />
            Adjuntar estado de cuentas (Excel)
          </label>
          <button type="submit" class="btn btn-warning">Enviar boletos</button>
        </form>
      </div>
    </div>

    <!-- hISTORICO DE ENVIO DE BOLETOS-->
    <div class="col-6 col-sm-6 col-md-3 col-lg-2">
      <div class="card h-80 p-4">
        <!-- <h3>Histórico envíos</h3> -->
        <!-- <p class="text-muted mb-2">Ver el historial de envíos de boletos y descargar imágenes adjuntas.</p> -->
        <a class="btn btn-secondary" href="/admin/envios-boletos"
          >Ver los envíos</a
        >
      </div>
    </div>

    <div class="col-6 col-sm-6 col-md-3 col-lg-2">
      <div class="card h-80 p-4">
        <h3>Limpieza anual</h3>
        <p class="small text-muted mb-2">
          Se aplica solo a esta variante (<strong><%= appVariant %></strong>) y a su base de datos.
        </p>
        <form method="POST" action="/admin/limpieza-anual" onsubmit="return confirm('¿Eliminar los registros y archivos de 2025 y anteriores?');">
          <label class="form-label small mb-1" for="cleanup-year">Año límite</label>
          <input id="cleanup-year" name="year" type="number" min="2000" value="2025" class="form-control mb-2" />
          <button type="submit" class="btn btn-danger">Ejecutar limpieza</button>
        </form>
      </div>
    </div>
  </div>
</section>
